# Register a GitHub OAuth App. Callback: https://your-domain/api/auth/callback
# For local development: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate a random secret of at least 32 characters. Never prefix with NEXT_PUBLIC_.
SESSION_SECRET=
APP_URL=http://localhost:3000
# oauth: requests the repo scope (access to private repositories; disclosed in UI).
# app: GitHub App user authorization; install it on chat repositories first.
GITHUB_AUTH_MODE=oauth
# Optional GitHub App installation URL, shown in repository connection UI.
GITHUB_APP_INSTALL_URL=
